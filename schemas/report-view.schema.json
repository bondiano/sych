{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReportView",
  "type": "object",
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ReportFinding"
      }
    },
    "gaps": {
      "$ref": "#/$defs/ReportGaps"
    },
    "header": {
      "$ref": "#/$defs/ReportHeader"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    }
  },
  "required": [
    "schema_version",
    "header",
    "findings",
    "gaps"
  ],
  "$defs": {
    "AlsoFinding": {
      "description": "A confirmed finding merged into an overlapping, at least as severe one.",
      "type": "object",
      "properties": {
        "anchors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CodeRef"
          }
        },
        "category": {
          "$ref": "#/$defs/FindingCategory"
        },
        "consequence": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "title": {
          "type": "string"
        },
        "triggering_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "category",
        "severity",
        "title",
        "explanation",
        "triggering_conditions",
        "consequence",
        "anchors"
      ]
    },
    "BillingKind": {
      "type": "string",
      "enum": [
        "api_usage",
        "subscription_quota"
      ]
    },
    "CodeRef": {
      "description": "Exact span inside a pinned blob; resolved by the harness, never by a model.",
      "type": "object",
      "properties": {
        "blob_oid": {
          "$ref": "#/$defs/GitObjectId"
        },
        "content_sha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "end_line": {
          "description": "1-based, inclusive.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "path": {
          "$ref": "#/$defs/RepoPath"
        },
        "side": {
          "$ref": "#/$defs/SourceSide"
        },
        "snapshot_id": {
          "$ref": "#/$defs/SourceSnapshotId"
        },
        "start_line": {
          "description": "1-based, inclusive.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "snapshot_id",
        "side",
        "path",
        "blob_oid",
        "start_line",
        "end_line",
        "content_sha256"
      ]
    },
    "ComparisonMode": {
      "description": "How `diff_base` was chosen; never an arbitrary commit.",
      "oneOf": [
        {
          "description": "`diff_base = merge-base(target_tip, head)`.",
          "type": "string",
          "const": "MERGE_BASE"
        },
        {
          "description": "`diff_base` was given explicitly for a two-dot comparison.",
          "type": "string",
          "const": "EXPLICIT_DIFF_BASE"
        }
      ]
    },
    "CostSummary": {
      "description": "Cost with explicit unknown part; an unknown charge is never recorded as zero.",
      "type": "object",
      "properties": {
        "known": {
          "description": "Money the providers reported, or the price card computed, for settled API attempts.",
          "$ref": "#/$defs/MicroUsd"
        },
        "reference_estimate": {
          "description": "List-price estimate of the attempts with complete usage; not a charge.",
          "$ref": "#/$defs/MicroUsd"
        },
        "unknown_cost_attempts": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "known",
        "reference_estimate",
        "unknown_cost_attempts"
      ]
    },
    "Coverage": {
      "type": "string",
      "enum": [
        "COMPLETE_FOR_SCOPE",
        "PARTIAL",
        "UNAVAILABLE"
      ]
    },
    "Enforcement": {
      "type": "string",
      "enum": [
        "api_hard",
        "subscription_observable"
      ]
    },
    "ExecutionOutcome": {
      "description": "How the run reached FINALIZING; recorded inside the immutable result.",
      "oneOf": [
        {
          "description": "Every planned task ran.",
          "type": "string",
          "const": "PLAN_EXECUTED"
        },
        {
          "description": "A budget or size limit stopped the plan; skipped work is listed as gaps.",
          "type": "string",
          "const": "LIMIT_REACHED"
        },
        {
          "description": "Retryable failures exhausted their retries; an honest partial result is kept.",
          "type": "string",
          "const": "RETRIES_EXHAUSTED"
        },
        {
          "description": "Substantive analysis was impossible, for example the diff could not be read.",
          "type": "string",
          "const": "INPUT_UNAVAILABLE"
        }
      ]
    },
    "FeeShare": {
      "description": "A subscription fee for one calendar month (UTC); charged to the monthly pool once, not per\nrequest or run.",
      "type": "object",
      "properties": {
        "allocated": {
          "$ref": "#/$defs/MicroUsd"
        },
        "amount": {
          "$ref": "#/$defs/MicroUsd"
        },
        "period": {
          "description": "`YYYY-MM`.",
          "type": "string"
        }
      },
      "required": [
        "period",
        "amount",
        "allocated"
      ]
    },
    "FindingCategory": {
      "type": "string",
      "enum": [
        "DEFECT",
        "RULE_VIOLATION",
        "IMPROVEMENT",
        "NIT"
      ]
    },
    "GitObjectId": {
      "type": "string",
      "pattern": "^(sha1:[0-9a-f]{40}|sha256:[0-9a-f]{64})$"
    },
    "Lifecycle": {
      "type": "string",
      "enum": [
        "OPEN",
        "RESOLVED",
        "DISMISSED",
        "OBSOLETE"
      ]
    },
    "MicroUsd": {
      "description": "Money as whole micro-USD; never a float.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "PathGap": {
      "description": "A path left out of reading or review, with the reason.",
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/$defs/RepoPath"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "reason"
      ]
    },
    "Recommendation": {
      "description": "Computed by the reducer; never a model verdict or SCM approval.",
      "type": "string",
      "enum": [
        "ATTENTION_REQUIRED",
        "NEEDS_EVIDENCE",
        "NO_BLOCKING_FINDINGS_IN_SCOPE"
      ]
    },
    "RepoPath": {
      "type": "string",
      "minLength": 1
    },
    "ReportAnchor": {
      "type": "object",
      "properties": {
        "diff": {
          "description": "Nearby hunks of the reviewed change.",
          "type": [
            "string",
            "null"
          ]
        },
        "excerpt": {
          "description": "Absent when the source is unavailable.",
          "anyOf": [
            {
              "$ref": "#/$defs/ReportExcerpt"
            },
            {
              "type": "null"
            }
          ]
        },
        "reference": {
          "$ref": "#/$defs/CodeRef"
        }
      },
      "required": [
        "reference"
      ]
    },
    "ReportCount": {
      "type": "object",
      "properties": {
        "category": {
          "$ref": "#/$defs/FindingCategory"
        },
        "count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "required": [
        "severity",
        "category",
        "count"
      ]
    },
    "ReportExcerpt": {
      "type": "object",
      "properties": {
        "first_line": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "text": {
          "description": "The owning anchor's inclusive start and end mark the relevant lines in this text.",
          "type": "string"
        }
      },
      "required": [
        "first_line",
        "text"
      ]
    },
    "ReportFinding": {
      "type": "object",
      "properties": {
        "also": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AlsoFinding"
          }
        },
        "anchors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReportAnchor"
          }
        },
        "category": {
          "$ref": "#/$defs/FindingCategory"
        },
        "consequence": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        },
        "fix_note": {
          "description": "Why a stored suggestion could not be shown or exported.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "lifecycle": {
          "$ref": "#/$defs/Lifecycle"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "remediation": {
          "type": [
            "string",
            "null"
          ]
        },
        "rule_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "suggested_action": {
          "type": "string"
        },
        "suggested_patch": {
          "description": "Unified diff for the suggested fix when its pinned source is available.",
          "type": [
            "string",
            "null"
          ]
        },
        "support": {
          "$ref": "#/$defs/Support"
        },
        "title": {
          "type": "string"
        },
        "triggering_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validation_expectation": {
          "type": "string"
        },
        "verification_status": {
          "$ref": "#/$defs/VerificationStatus"
        }
      },
      "required": [
        "id",
        "category",
        "severity",
        "lifecycle",
        "verification_status",
        "support",
        "title",
        "explanation",
        "triggering_conditions",
        "consequence",
        "anchors",
        "also",
        "suggested_action",
        "validation_expectation",
        "limitations"
      ]
    },
    "ReportGaps": {
      "type": "object",
      "properties": {
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PathGap"
          }
        },
        "unknown_obligations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReportUnknown"
          }
        },
        "unresolved_candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReportUnresolved"
          }
        }
      },
      "required": [
        "unknown_obligations",
        "paths",
        "open_questions",
        "unresolved_candidates"
      ]
    },
    "ReportHeader": {
      "type": "object",
      "properties": {
        "counts": {
          "description": "Nonzero counts, grouped by severity and category.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReportCount"
          }
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "execution_outcome": {
          "$ref": "#/$defs/ExecutionOutcome"
        },
        "recommendation": {
          "$ref": "#/$defs/Recommendation"
        },
        "result_id": {
          "type": "string",
          "format": "uuid"
        },
        "review_revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "snapshot": {
          "description": "Absent after the source snapshot is pruned.",
          "anyOf": [
            {
              "$ref": "#/$defs/SourceSnapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "usage": {
          "$ref": "#/$defs/UsageSummary"
        }
      },
      "required": [
        "run_id",
        "result_id",
        "review_revision",
        "recommendation",
        "coverage",
        "execution_outcome",
        "counts",
        "usage"
      ]
    },
    "ReportUnknown": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "next_evidence_needed": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "reason_code": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "rule_id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "rule_id",
        "question",
        "required",
        "reason_code",
        "next_evidence_needed"
      ]
    },
    "ReportUnresolved": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verification_status": {
          "$ref": "#/$defs/VerificationStatus"
        }
      },
      "required": [
        "id",
        "verification_status",
        "limitations"
      ]
    },
    "RouteUsage": {
      "description": "One model route of the run: how it bills and which caps are hard.",
      "type": "object",
      "properties": {
        "attempts": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "billing": {
          "$ref": "#/$defs/BillingKind"
        },
        "enforcement": {
          "$ref": "#/$defs/Enforcement"
        },
        "fixed_fee": {
          "anyOf": [
            {
              "$ref": "#/$defs/FeeShare"
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "quota_attempts": {
          "description": "Subscription attempts settled with no reported money: they spent included quota, which\nis not free. Remaining quota and its reset are not reported by any connected transport.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "profile",
        "model",
        "billing",
        "enforcement",
        "attempts",
        "quota_attempts"
      ]
    },
    "SchemaVersion": {
      "type": "integer",
      "const": 1
    },
    "Severity": {
      "type": "string",
      "enum": [
        "INFO",
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "Sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "SnapshotHeadKind": {
      "description": "Where the reviewed head's content came from.",
      "type": "string",
      "enum": [
        "COMMITTED",
        "STAGED",
        "WORKTREE"
      ]
    },
    "SourceSide": {
      "type": "string",
      "enum": [
        "DIFF_BASE",
        "HEAD",
        "TARGET_TIP"
      ]
    },
    "SourceSnapshot": {
      "description": "Immutable source positions of one review. `target_tip` and `diff_base` are separate fields.",
      "type": "object",
      "properties": {
        "comparison": {
          "$ref": "#/$defs/ComparisonMode"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "diff_base": {
          "$ref": "#/$defs/GitObjectId"
        },
        "diff_manifest_hash": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "head": {
          "$ref": "#/$defs/GitObjectId"
        },
        "head_kind": {
          "$ref": "#/$defs/SnapshotHeadKind"
        },
        "id": {
          "$ref": "#/$defs/SourceSnapshotId"
        },
        "repository": {
          "description": "Opaque repository identity, not a host path.",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "source_manifest_hash": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "target_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_tip": {
          "$ref": "#/$defs/GitObjectId"
        }
      },
      "required": [
        "schema_version",
        "id",
        "repository",
        "target_tip",
        "diff_base",
        "head",
        "comparison",
        "source_manifest_hash",
        "diff_manifest_hash",
        "created_at"
      ]
    },
    "SourceSnapshotId": {
      "description": "Content-derived identity of a [`crate::SourceSnapshot`].",
      "$ref": "#/$defs/Sha256Digest"
    },
    "Support": {
      "description": "Kind of support; independent of severity.",
      "type": "string",
      "enum": [
        "EXECUTED_COUNTEREXAMPLE",
        "STATIC_TRACE",
        "SEMANTIC_ARGUMENT",
        "EXPLICIT_RULE",
        "PREFERENCE"
      ]
    },
    "UsageSummary": {
      "type": "object",
      "properties": {
        "cost": {
          "$ref": "#/$defs/CostSummary"
        },
        "input_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "model_attempts": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "reasoning_tokens": {
          "description": "Already part of `output_tokens`; never added to it.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "routes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RouteUsage"
          }
        },
        "unknown_usage_attempts": {
          "description": "Dispatched attempts whose tokens were not reported; the token sums leave them out.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "model_attempts",
        "input_tokens",
        "output_tokens",
        "reasoning_tokens",
        "unknown_usage_attempts",
        "cost",
        "routes"
      ]
    },
    "VerificationStatus": {
      "type": "string",
      "enum": [
        "PENDING",
        "CONFIRMED",
        "REJECTED",
        "UNRESOLVED"
      ]
    }
  }
}
