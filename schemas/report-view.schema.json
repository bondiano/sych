{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReportView",
  "type": "object",
  "properties": {
    "architecture": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ArchitectureFacts"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Evidence"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ReportFinding"
      }
    },
    "fixes_patch": {
      "description": "Combined unified patch of applicable suggested fixes on head.",
      "type": [
        "string",
        "null"
      ]
    },
    "gaps": {
      "$ref": "#/$defs/ReportGaps"
    },
    "header": {
      "$ref": "#/$defs/ReportHeader"
    },
    "obligations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Obligation"
      }
    },
    "policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReportPolicy"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    }
  },
  "required": [
    "schema_version",
    "header",
    "findings",
    "gaps"
  ],
  "$defs": {
    "AlsoFinding": {
      "description": "A confirmed finding merged into an overlapping, at least as severe one.",
      "type": "object",
      "properties": {
        "anchors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CodeRef"
          }
        },
        "category": {
          "$ref": "#/$defs/FindingCategory"
        },
        "consequence": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "title": {
          "type": "string"
        },
        "triggering_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "category",
        "severity",
        "title",
        "explanation",
        "triggering_conditions",
        "consequence",
        "anchors"
      ]
    },
    "Applicability": {
      "description": "Three-valued rule applicability.",
      "type": "string",
      "enum": [
        "APPLIES",
        "DOES_NOT_APPLY",
        "UNKNOWN"
      ]
    },
    "ArchitectureFacts": {
      "type": "object",
      "properties": {
        "base_checked": {
          "description": "The diff base was checked: without it no finding is new or old.",
          "type": "boolean"
        },
        "coverage": {
          "description": "Per check: what it proves. A circle found stands; an index that cannot see some code\ndoes not prove that no other one is there.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/CheckCoverage"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArchitectureFinding"
          }
        },
        "fixed": {
          "description": "Findings of the diff base that head no longer has.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FixedFinding"
          }
        },
        "language": {
          "$ref": "#/$defs/Language"
        },
        "limitations": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "limits": {
          "$ref": "#/$defs/Limits"
        },
        "producer": {
          "description": "The pinned indexer and its version; `config_hash` covers the limits.",
          "$ref": "#/$defs/Producer"
        },
        "project": {
          "description": "The project's directory, `\"\"` for the repository's root.",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "source_snapshot_id": {
          "$ref": "#/$defs/SourceSnapshotId"
        },
        "status": {
          "$ref": "#/$defs/BackendStatus"
        }
      },
      "required": [
        "schema_version",
        "source_snapshot_id",
        "producer",
        "language",
        "project",
        "status",
        "base_checked",
        "limits",
        "coverage",
        "findings"
      ]
    },
    "ArchitectureFinding": {
      "type": "object",
      "properties": {
        "base_size": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "change": {
          "description": "Against the diff base; `None` when it was not checked.",
          "anyOf": [
            {
              "$ref": "#/$defs/Change"
            },
            {
              "type": "null"
            }
          ]
        },
        "check": {
          "$ref": "#/$defs/Check"
        },
        "code_ref": {
          "description": "Where it is reported, on head; a finding in a file the change does not touch has one.",
          "anyOf": [
            {
              "$ref": "#/$defs/CodeRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "key": {
          "description": "The members' names, the field's, the module's or the path: never a line.",
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "picture": {
          "description": "The shape of what was found, drawn in box-drawing characters.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "size": {
          "description": "Members of the circle, places the field is known, functions shown, directory members\nor lines.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "check",
        "key",
        "message",
        "notes",
        "picture",
        "size"
      ]
    },
    "BackendStatus": {
      "type": "string",
      "enum": [
        "READY",
        "UNSUPPORTED",
        "FAILED"
      ]
    },
    "BillingKind": {
      "type": "string",
      "enum": [
        "api_usage",
        "subscription_quota"
      ]
    },
    "BindingKind": {
      "type": "string",
      "enum": [
        "source",
        "ci",
        "environment"
      ]
    },
    "Change": {
      "oneOf": [
        {
          "description": "The base has nothing like it.",
          "type": "string",
          "const": "NEW"
        },
        {
          "description": "The base has it, smaller.",
          "type": "string",
          "const": "WORSE"
        },
        {
          "description": "The base has it as it is: existing debt.",
          "type": "string",
          "const": "SAME"
        },
        {
          "description": "The base has it, larger: the change improved it.",
          "type": "string",
          "const": "BETTER"
        }
      ]
    },
    "Check": {
      "type": "string",
      "enum": [
        "module-cycle",
        "tangle",
        "field-leak",
        "shallow-module",
        "wide-directory",
        "long-file"
      ]
    },
    "CheckCoverage": {
      "type": "object",
      "properties": {
        "check": {
          "$ref": "#/$defs/Check"
        },
        "completeness": {
          "$ref": "#/$defs/Completeness"
        },
        "reason": {
          "description": "Why it is partial.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "check",
        "completeness"
      ]
    },
    "CodeRef": {
      "description": "Exact span inside a pinned blob; resolved by the harness, never by a model.",
      "type": "object",
      "properties": {
        "blob_oid": {
          "$ref": "#/$defs/GitObjectId"
        },
        "content_sha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "end_line": {
          "description": "1-based, inclusive.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "path": {
          "$ref": "#/$defs/RepoPath"
        },
        "side": {
          "$ref": "#/$defs/SourceSide"
        },
        "snapshot_id": {
          "$ref": "#/$defs/SourceSnapshotId"
        },
        "start_line": {
          "description": "1-based, inclusive.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "snapshot_id",
        "side",
        "path",
        "blob_oid",
        "start_line",
        "end_line",
        "content_sha256"
      ]
    },
    "ComparisonMode": {
      "description": "How `diff_base` was chosen; never an arbitrary commit.",
      "oneOf": [
        {
          "description": "`diff_base = merge-base(target_tip, head)`.",
          "type": "string",
          "const": "MERGE_BASE"
        },
        {
          "description": "`diff_base` was given explicitly for a two-dot comparison.",
          "type": "string",
          "const": "EXPLICIT_DIFF_BASE"
        }
      ]
    },
    "Completeness": {
      "type": "string",
      "enum": [
        "COMPLETE_FOR_QUERY",
        "PARTIAL",
        "UNKNOWN"
      ]
    },
    "CostSummary": {
      "description": "Cost with explicit unknown part; an unknown charge is never recorded as zero.",
      "type": "object",
      "properties": {
        "known": {
          "description": "Money the providers reported, or the price card computed, for settled API attempts.",
          "$ref": "#/$defs/MicroUsd"
        },
        "reference_estimate": {
          "description": "List-price estimate of the attempts with complete usage; not a charge.",
          "$ref": "#/$defs/MicroUsd"
        },
        "unknown_cost_attempts": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "known",
        "reference_estimate",
        "unknown_cost_attempts"
      ]
    },
    "Coverage": {
      "type": "string",
      "enum": [
        "COMPLETE_FOR_SCOPE",
        "PARTIAL",
        "UNAVAILABLE"
      ]
    },
    "Enforcement": {
      "type": "string",
      "enum": [
        "api_hard",
        "subscription_observable"
      ]
    },
    "EvaluationMode": {
      "description": "How a migration obligation is judged: the plan alone, or an observed\ntransition of a real environment, which needs evidence of that environment's state.",
      "type": "string",
      "enum": [
        "PLAN_REVIEW",
        "OBSERVED_TRANSITION"
      ]
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "artifact_sha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "binding": {
          "$ref": "#/$defs/EvidenceBinding"
        },
        "code_refs": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/CodeRef"
          }
        },
        "completeness": {
          "$ref": "#/$defs/Completeness"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "limitations": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "producer": {
          "$ref": "#/$defs/Producer"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "source_snapshot_id": {
          "$ref": "#/$defs/SourceSnapshotId"
        },
        "trust_class": {
          "$ref": "#/$defs/TrustClass"
        },
        "validity": {
          "$ref": "#/$defs/Validity"
        }
      },
      "required": [
        "schema_version",
        "id",
        "kind",
        "source_snapshot_id",
        "producer",
        "binding",
        "validity",
        "completeness",
        "trust_class",
        "artifact_sha256",
        "observed_at"
      ]
    },
    "EvidenceBinding": {
      "description": "What the evidence was observed against.",
      "type": "object",
      "properties": {
        "environment_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "head_oid": {
          "anyOf": [
            {
              "$ref": "#/$defs/GitObjectId"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "$ref": "#/$defs/BindingKind"
        },
        "target_tip_oid": {
          "anyOf": [
            {
              "$ref": "#/$defs/GitObjectId"
            },
            {
              "type": "null"
            }
          ]
        },
        "tested_oid": {
          "anyOf": [
            {
              "$ref": "#/$defs/GitObjectId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind"
      ]
    },
    "EvidenceKind": {
      "type": "string",
      "enum": [
        "source",
        "semantic",
        "static",
        "test",
        "coverage",
        "contract",
        "infrastructure",
        "human"
      ]
    },
    "ExecutionOutcome": {
      "description": "How the run reached FINALIZING; recorded inside the immutable result.",
      "oneOf": [
        {
          "description": "Every planned task ran.",
          "type": "string",
          "const": "PLAN_EXECUTED"
        },
        {
          "description": "A budget or size limit stopped the plan; skipped work is listed as gaps.",
          "type": "string",
          "const": "LIMIT_REACHED"
        },
        {
          "description": "Retryable failures exhausted their retries; an honest partial result is kept.",
          "type": "string",
          "const": "RETRIES_EXHAUSTED"
        },
        {
          "description": "Substantive analysis was impossible, for example the diff could not be read.",
          "type": "string",
          "const": "INPUT_UNAVAILABLE"
        }
      ]
    },
    "FeeShare": {
      "description": "A subscription fee for one calendar month (UTC); charged to the monthly pool once, not per\nrequest or run.",
      "type": "object",
      "properties": {
        "allocated": {
          "$ref": "#/$defs/MicroUsd"
        },
        "amount": {
          "$ref": "#/$defs/MicroUsd"
        },
        "period": {
          "description": "`YYYY-MM`.",
          "type": "string"
        }
      },
      "required": [
        "period",
        "amount",
        "allocated"
      ]
    },
    "FindingCategory": {
      "type": "string",
      "enum": [
        "DEFECT",
        "RULE_VIOLATION",
        "IMPROVEMENT",
        "NIT"
      ]
    },
    "FixedFinding": {
      "type": "object",
      "properties": {
        "check": {
          "$ref": "#/$defs/Check"
        },
        "key": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "check",
        "key",
        "message"
      ]
    },
    "GitObjectId": {
      "type": "string",
      "pattern": "^(sha1:[0-9a-f]{40}|sha256:[0-9a-f]{64})$"
    },
    "Language": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "rust",
            "typescript",
            "go"
          ]
        },
        {
          "description": "ty, plus tree-sitter syntax facts.",
          "type": "string",
          "const": "python"
        }
      ]
    },
    "Lifecycle": {
      "type": "string",
      "enum": [
        "OPEN",
        "RESOLVED",
        "DISMISSED",
        "OBSOLETE"
      ]
    },
    "Limits": {
      "description": "The bounds the checks judge by; upstream's are the defaults.",
      "type": "object",
      "properties": {
        "long_file": {
          "description": "A file has at most this many lines, blank and comment lines too.",
          "type": "integer",
          "format": "uint",
          "default": 2000,
          "minimum": 0
        },
        "shallow_functions": {
          "description": "A module is shallow past this many functions shown, and only with a list (of things,\nor of one thing's functions) past it.",
          "type": "integer",
          "format": "uint",
          "default": 7,
          "minimum": 0
        },
        "tangle_members": {
          "description": "A tangle all in one module is reported past this many things: its members cannot be\nlearned one at a time.",
          "type": "integer",
          "format": "uint",
          "default": 7,
          "minimum": 0
        },
        "wide_directory": {
          "description": "A directory holds at most this many files and directories of code.",
          "type": "integer",
          "format": "uint",
          "default": 15,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "MicroUsd": {
      "description": "Money as whole micro-USD; never a float.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "Obligation": {
      "description": "One concrete question with its rule, scope, acceptance criterion and assessment.",
      "type": "object",
      "properties": {
        "acceptable_evidence_kinds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceKind"
          }
        },
        "acceptance_criterion": {
          "type": "string"
        },
        "applicability": {
          "$ref": "#/$defs/Applicability"
        },
        "code_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CodeRef"
          }
        },
        "evaluation_mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvaluationMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_ids": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "limitations": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "question": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "review_unit_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "risk_level": {
          "$ref": "#/$defs/RiskLevel"
        },
        "rule_id": {
          "type": "string"
        },
        "rule_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "waivers": {
          "description": "Scoped exceptions in force; they lower the risk decision and never rewrite `status`.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Waiver"
          }
        }
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "SUPPORTED"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "VIOLATED"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "next_evidence_needed": {
              "type": "string"
            },
            "reason_code": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "const": "UNKNOWN"
            }
          },
          "required": [
            "status",
            "reason_code",
            "next_evidence_needed"
          ]
        },
        {
          "type": "object",
          "properties": {
            "basis": {
              "description": "Checkable basis of non-applicability.",
              "type": "string"
            },
            "status": {
              "type": "string",
              "const": "NOT_APPLICABLE"
            }
          },
          "required": [
            "status",
            "basis"
          ]
        }
      ],
      "required": [
        "id",
        "rule_id",
        "rule_version",
        "question",
        "required",
        "risk_level",
        "review_unit_ids",
        "code_refs",
        "applicability",
        "acceptance_criterion",
        "acceptable_evidence_kinds"
      ]
    },
    "PathGap": {
      "description": "A path left out of reading or review, with the reason.",
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/$defs/RepoPath"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "reason"
      ]
    },
    "PolicySnapshot": {
      "type": "object",
      "properties": {
        "authorization_policy_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "config_hash": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "id": {
          "$ref": "#/$defs/PolicySnapshotId"
        },
        "rules_hash": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "source": {
          "$ref": "#/$defs/PolicySource"
        }
      },
      "required": [
        "schema_version",
        "id",
        "source",
        "rules_hash",
        "config_hash",
        "authorization_policy_version",
        "created_at"
      ]
    },
    "PolicySnapshotId": {
      "description": "Content-derived identity of a [`crate::PolicySnapshot`].",
      "$ref": "#/$defs/Sha256Digest"
    },
    "PolicySource": {
      "description": "Where active rules came from. The reviewed head is never a policy source.",
      "oneOf": [
        {
          "description": "Engine defaults only; no repository policy was accepted.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "engine_defaults"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "description": "Policy read from an accepted ref pinned to a commit.",
          "type": "object",
          "properties": {
            "commit": {
              "$ref": "#/$defs/GitObjectId"
            },
            "kind": {
              "type": "string",
              "const": "trusted_ref"
            },
            "ref_name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "ref_name",
            "commit"
          ]
        }
      ]
    },
    "Producer": {
      "type": "object",
      "properties": {
        "config_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "Provenance": {
      "type": "object",
      "properties": {
        "engine_version": {
          "type": "string"
        },
        "model_adapters": {
          "description": "Model adapters used, e.g. `fake`; a fake adapter proves the harness, not model quality.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "engine_version",
        "model_adapters"
      ]
    },
    "Recommendation": {
      "description": "Computed by the reducer; never a model verdict or SCM approval.",
      "type": "string",
      "enum": [
        "ATTENTION_REQUIRED",
        "NEEDS_EVIDENCE",
        "NO_BLOCKING_FINDINGS_IN_SCOPE"
      ]
    },
    "RepoPath": {
      "type": "string",
      "minLength": 1
    },
    "ReportAnchor": {
      "type": "object",
      "properties": {
        "diff": {
          "description": "Nearby hunks of the reviewed change.",
          "type": [
            "string",
            "null"
          ]
        },
        "excerpt": {
          "description": "Absent when the source is unavailable.",
          "anyOf": [
            {
              "$ref": "#/$defs/ReportExcerpt"
            },
            {
              "type": "null"
            }
          ]
        },
        "reference": {
          "$ref": "#/$defs/CodeRef"
        }
      },
      "required": [
        "reference"
      ]
    },
    "ReportCodeLinks": {
      "description": "Provider blob link coordinates when the run is bound to a remote repository.",
      "type": "object",
      "properties": {
        "base": {
          "type": "string"
        },
        "base_url": {
          "description": "Origin and optional base path without trailing slash, e.g. `https://github.com`.",
          "type": "string"
        },
        "head": {
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/ReportCodeProvider"
        },
        "repo": {
          "description": "`owner/repo` or `group/subgroup/project`.",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "base_url",
        "repo",
        "head",
        "base"
      ]
    },
    "ReportCodeProvider": {
      "type": "string",
      "enum": [
        "github",
        "gitlab"
      ]
    },
    "ReportCount": {
      "type": "object",
      "properties": {
        "category": {
          "$ref": "#/$defs/FindingCategory"
        },
        "count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "required": [
        "severity",
        "category",
        "count"
      ]
    },
    "ReportExcerpt": {
      "type": "object",
      "properties": {
        "first_line": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "text": {
          "description": "The owning anchor's inclusive start and end mark the relevant lines in this text.",
          "type": "string"
        }
      },
      "required": [
        "first_line",
        "text"
      ]
    },
    "ReportFinding": {
      "type": "object",
      "properties": {
        "also": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AlsoFinding"
          }
        },
        "anchors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReportAnchor"
          }
        },
        "category": {
          "$ref": "#/$defs/FindingCategory"
        },
        "consequence": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        },
        "fix_note": {
          "description": "Why a stored suggestion could not be shown or exported.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "lifecycle": {
          "$ref": "#/$defs/Lifecycle"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "picture": {
          "description": "Static architecture box-drawing diagram extracted from `explanation` when present.",
          "type": [
            "string",
            "null"
          ]
        },
        "remediation": {
          "type": [
            "string",
            "null"
          ]
        },
        "rule_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "suggested_action": {
          "type": "string"
        },
        "suggested_patch": {
          "description": "Unified diff for the suggested fix when its pinned source is available.",
          "type": [
            "string",
            "null"
          ]
        },
        "support": {
          "$ref": "#/$defs/Support"
        },
        "title": {
          "type": "string"
        },
        "triggering_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validation_expectation": {
          "type": "string"
        },
        "verification_status": {
          "$ref": "#/$defs/VerificationStatus"
        }
      },
      "required": [
        "id",
        "category",
        "severity",
        "lifecycle",
        "verification_status",
        "support",
        "title",
        "explanation",
        "triggering_conditions",
        "consequence",
        "anchors",
        "also",
        "suggested_action",
        "validation_expectation",
        "limitations"
      ]
    },
    "ReportGaps": {
      "type": "object",
      "properties": {
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PathGap"
          }
        },
        "unknown_obligations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReportUnknown"
          }
        },
        "unresolved_candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReportUnresolved"
          }
        }
      },
      "required": [
        "unknown_obligations",
        "paths",
        "open_questions",
        "unresolved_candidates"
      ]
    },
    "ReportHeader": {
      "type": "object",
      "properties": {
        "code_links": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReportCodeLinks"
            },
            {
              "type": "null"
            }
          ]
        },
        "counts": {
          "description": "Nonzero counts, grouped by severity and category.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReportCount"
          }
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "execution_outcome": {
          "$ref": "#/$defs/ExecutionOutcome"
        },
        "language": {
          "$ref": "#/$defs/ReviewLanguage",
          "default": "en"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "recommendation": {
          "$ref": "#/$defs/Recommendation"
        },
        "result_id": {
          "type": "string",
          "format": "uuid"
        },
        "review_revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "scope": {
          "$ref": "#/$defs/ScopeManifest"
        },
        "snapshot": {
          "description": "Absent after the source snapshot is pruned.",
          "anyOf": [
            {
              "$ref": "#/$defs/SourceSnapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "usage": {
          "$ref": "#/$defs/UsageSummary"
        }
      },
      "required": [
        "run_id",
        "result_id",
        "review_revision",
        "recommendation",
        "coverage",
        "execution_outcome",
        "counts",
        "usage",
        "created_at",
        "provenance",
        "scope"
      ]
    },
    "ReportPolicy": {
      "type": "object",
      "properties": {
        "head_errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "proposed_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "proposed_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReportPolicyProvenance"
          }
        },
        "snapshot": {
          "$ref": "#/$defs/PolicySnapshot"
        }
      },
      "required": [
        "snapshot",
        "provenance"
      ]
    },
    "ReportPolicyProvenance": {
      "type": "object",
      "properties": {
        "layer": {
          "type": "string"
        },
        "origin": {
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256Digest"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "layer",
        "origin"
      ]
    },
    "ReportUnknown": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "next_evidence_needed": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "reason_code": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "rule_id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "rule_id",
        "question",
        "required",
        "reason_code",
        "next_evidence_needed"
      ]
    },
    "ReportUnresolved": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verification_status": {
          "$ref": "#/$defs/VerificationStatus"
        }
      },
      "required": [
        "id",
        "verification_status",
        "limitations"
      ]
    },
    "ReviewLanguage": {
      "description": "The language of every human-readable text a review writes (`review.language`): model\nprose and the static text of published comments. Code, paths, ids and enum values stay as\nthey are.",
      "type": "string",
      "enum": [
        "en",
        "ru"
      ]
    },
    "ReviewUnit": {
      "description": "Related changes reviewed together around one contract or behavior.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "paths": {
          "description": "Where each file is reported: its new path, or old path when deleted. A renamed file's\nold path is still part of its identity in the diff manifest.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/RepoPath"
          }
        },
        "risk_hints": {
          "description": "Routing hints from the planner; not evidence of a defect.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/RiskHint"
          }
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "paths"
      ]
    },
    "RiskHint": {
      "type": "object",
      "properties": {
        "code": {
          "description": "Stable code such as `MIGRATION` or `CI_CONFIG`.",
          "type": "string"
        },
        "level": {
          "$ref": "#/$defs/RiskLevel"
        },
        "path": {
          "$ref": "#/$defs/RepoPath"
        }
      },
      "required": [
        "level",
        "code",
        "path"
      ]
    },
    "RiskLevel": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "RouteUsage": {
      "description": "One model route of the run: how it bills and which caps are hard.",
      "type": "object",
      "properties": {
        "attempts": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "billing": {
          "$ref": "#/$defs/BillingKind"
        },
        "enforcement": {
          "$ref": "#/$defs/Enforcement"
        },
        "fixed_fee": {
          "anyOf": [
            {
              "$ref": "#/$defs/FeeShare"
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "quota_attempts": {
          "description": "Subscription attempts settled with no reported money: they spent included quota, which\nis not free. Remaining quota and its reset are not reported by any connected transport.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "profile",
        "model",
        "billing",
        "enforcement",
        "attempts",
        "quota_attempts"
      ]
    },
    "SchemaVersion": {
      "type": "integer",
      "const": 1
    },
    "ScopeManifest": {
      "description": "Fixed before discovery; may only grow through a new revision.",
      "type": "object",
      "properties": {
        "excluded": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PathGap"
          }
        },
        "requested_profiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_obligation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "revision": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "units": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReviewUnit"
          }
        }
      },
      "required": [
        "revision",
        "units",
        "required_obligation_ids",
        "requested_profiles",
        "excluded"
      ]
    },
    "Severity": {
      "type": "string",
      "enum": [
        "INFO",
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "Sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "SnapshotHeadKind": {
      "description": "Where the reviewed head's content came from.",
      "type": "string",
      "enum": [
        "COMMITTED",
        "STAGED",
        "WORKTREE"
      ]
    },
    "SourceSide": {
      "type": "string",
      "enum": [
        "DIFF_BASE",
        "HEAD",
        "TARGET_TIP"
      ]
    },
    "SourceSnapshot": {
      "description": "Immutable source positions of one review. `target_tip` and `diff_base` are separate fields.",
      "type": "object",
      "properties": {
        "comparison": {
          "$ref": "#/$defs/ComparisonMode"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "diff_base": {
          "$ref": "#/$defs/GitObjectId"
        },
        "diff_manifest_hash": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "head": {
          "$ref": "#/$defs/GitObjectId"
        },
        "head_kind": {
          "$ref": "#/$defs/SnapshotHeadKind"
        },
        "head_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "$ref": "#/$defs/SourceSnapshotId"
        },
        "repository": {
          "description": "Opaque repository identity, not a host path.",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "source_manifest_hash": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "target_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_tip": {
          "$ref": "#/$defs/GitObjectId"
        }
      },
      "required": [
        "schema_version",
        "id",
        "repository",
        "target_tip",
        "diff_base",
        "head",
        "comparison",
        "source_manifest_hash",
        "diff_manifest_hash",
        "created_at"
      ]
    },
    "SourceSnapshotId": {
      "description": "Content-derived identity of a [`crate::SourceSnapshot`].",
      "$ref": "#/$defs/Sha256Digest"
    },
    "Support": {
      "description": "Kind of support; independent of severity.",
      "type": "string",
      "enum": [
        "EXECUTED_COUNTEREXAMPLE",
        "STATIC_TRACE",
        "SEMANTIC_ARGUMENT",
        "EXPLICIT_RULE",
        "PREFERENCE"
      ]
    },
    "TrustClass": {
      "description": "Provenance class. `AuthenticatedCi` proves origin, not oracle independence from the author.",
      "type": "string",
      "enum": [
        "TRUSTED_POLICY",
        "SOURCE_OBSERVATION",
        "DERIVED_LOCAL",
        "AUTHENTICATED_CI",
        "AUTHOR_CLAIM",
        "HUMAN_ATTESTATION"
      ]
    },
    "UsageSummary": {
      "type": "object",
      "properties": {
        "cost": {
          "$ref": "#/$defs/CostSummary"
        },
        "input_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "model_attempts": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "reasoning_tokens": {
          "description": "Already part of `output_tokens`; never added to it.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "routes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RouteUsage"
          }
        },
        "unknown_usage_attempts": {
          "description": "Dispatched attempts whose tokens were not reported; the token sums leave them out.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "model_attempts",
        "input_tokens",
        "output_tokens",
        "reasoning_tokens",
        "unknown_usage_attempts",
        "cost",
        "routes"
      ]
    },
    "Validity": {
      "type": "string",
      "enum": [
        "VALID",
        "STALE",
        "UNAVAILABLE",
        "MALFORMED",
        "FAILED"
      ]
    },
    "VerificationStatus": {
      "type": "string",
      "enum": [
        "PENDING",
        "CONFIRMED",
        "REJECTED",
        "UNRESOLVED"
      ]
    },
    "Waiver": {
      "description": "A rule exception in force for one obligation.",
      "type": "object",
      "properties": {
        "author": {
          "type": "string"
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "owner": {
          "type": "string"
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string"
        },
        "until": {
          "description": "Completion condition when there is no fixed expiry.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "paths",
        "reason",
        "owner",
        "author"
      ]
    }
  }
}
