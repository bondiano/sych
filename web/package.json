{
  "name": "sych-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "scripts": {
    "dev": "vite",
    "gen:api": "openapi-typescript ../schemas/openapi.json -o src/modules/Api/schema.gen.d.ts",
    "lint": "oxlint . && eslint . --cache --max-warnings 0",
    "lint:fix": "oxlint . --fix && eslint . --fix --cache",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "vue-tsc --build",
    "test": "vitest run",
    "build": "vite build",
    "check": "pnpm gen:api && pnpm lint && pnpm format:check && pnpm type-check && pnpm test && pnpm build"
  },
  "dependencies": {
    "@lucide/vue": "^1.65.0",
    "@tanstack/vue-query": "^5.105.0",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "openapi-fetch": "^0.17.0",
    "reka-ui": "^2.11.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@o-feod/eslint-structure-plugin": "^0.1.7",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.90.0",
    "eslint-plugin-vue": "^10.12.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn-vue": "^2.9.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.14"
  },
  "feod": {
    "rootDefault": {
      "layerDirs": {
        "global": "globals"
      },
      "modules": {
        "requirePublicEntry": true
      },
      "cycles": {
        "modules": true
      }
    }
  }
}
